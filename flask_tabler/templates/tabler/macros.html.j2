

{% macro render_datagrid_item(title) -%}
<div class="datagrid-item">
    <div class="datagrid-title">{{title}}</div>
    <div class="datagrid-content">{{ caller() }}</div>
</div>
{%- endmacro %}

{% macro render_pagination(pagination, endpoint, attributes="", pagination_query=None) %}
{% set extra_query = pagination_query|default({}, true)|urlencode %}
<ul class="pagination {{attributes}}">
    <li class="page-item {{ 'disabled' if not pagination.has_prev else '' }}">
        <a class="page-link" href="{{ url_for(endpoint, p=pagination.prev_num) }}{% if extra_query %}&{{ extra_query }}{% endif %}">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M15 6l-6 6l6 6"></path></svg>
        prev</a>
    </li>
    {% for page in pagination.iter_pages() %}
    {% if page %}
        <li class="page-item {{ 'active' if page == pagination.page else '' }}"> <a class="page-link" href="{{ url_for(endpoint, p=page) }}{% if extra_query %}&{{ extra_query }}{% endif %}">{{ page }}</a></li>
    {% else %}
      <li class="page-item disabled"> <a class="page-link" href="#">…</a></li>
    {% endif %}
    {% endfor %}
    <li class="page-item {{ 'disabled' if not pagination.has_next else '' }}">
        <a class="page-link" href="{{ url_for(endpoint, p=pagination.next_num) }}{% if extra_query %}&{{ extra_query }}{% endif %}">
        next
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M9 6l6 6l-6 6"></path></svg>
        </a>
    </li>
</ul>
{% endmacro %}

{% macro render_table_custom(objects, headers, header_titles=None, header_attributes=None, pagination=None, pagination_endpoint='', pagination_query=None) %}
<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-striped">
            <thead>
                <tr>
                    {% if header_titles %}
                        {% for header in header_titles %}
                            <th {% if header_attributes[header] %} class="{{header_attributes[header]}}" {% endif %}>{{ header }}</th>
                        {% endfor %}
                    {% else %}
                        {% for header in headers %}
                            <th {% if header_attributes[header] %} class="{{header_attributes[header]}}" {% endif %}>{{ header }}</th>
                        {% endfor %}
                    {% endif %}
                </tr>
            </thead>
            <tbody>
                {% for object in objects %}
                    <tr>
                        {% for header in headers %}
                            <td>{{ caller(object[header], header, object) }}</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% if pagination %}
    <div class="card-footer d-flex align-items-center">
        <p class="m-0 text-secondary">Showing
            <span>
                {{[(pagination.page - 1) * pagination.per_page + 1, pagination.total] | min}}
            </span>
            to 
            <span>
                {{ [(pagination.page) * pagination.per_page, pagination.total] | min}}
            </span>
             of 
            <span>
                {{pagination.total}}
            </span>
             entries
        </p>
        {{ render_pagination(pagination, pagination_endpoint, attributes="m-0 ms-auto", pagination_query=pagination_query) }}
    </div>
    {% endif %}
</div>
{% endmacro %}

{% macro render_file_input(name, label=None, multiple=False, accept=None, required=False) %}
<div class="mb-3">
    {% if label %}
    <label class="form-label">{{ label }}</label>
    {% endif %}
    <div class="custom-file-upload">
        <input type="file" id="{{ name }}" name="{{ name }}" class="form-control"
            {% if multiple %}multiple{% endif %}
            {% if accept %}accept="{{ accept }}"{% endif %}
            {% if required %}required{% endif %}>
    </div>
</div>
{% endmacro %}

{% macro render_artifact_table(artifacts) %}
<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-striped">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Type</th>
                    <th>Size</th>
                    <th>Checksum</th>
                    <th class="w-1">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for artifact in artifacts %}
                <tr>
                    <td>
                        <span class="text-truncate">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" 
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon me-1">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 3v4a1 1 0 0 0 1 1h4"></path>
                                <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"></path>
                            </svg>
                            {{ artifact.name }}
                        </span>
                    </td>
                    <td>
                        {% if artifact.file_type %}
                            <span class="badge bg-blue">{{ artifact.file_type.name }}</span>
                        {% else %}
                            <span class="text-secondary">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if artifact.size %}
                            {% set size = artifact.size %}
                            {% if size > 1024*1024*1024 %}
                                {{ "%.1f"|format(size/(1024*1024*1024)) }} GB
                            {% elif size > 1024*1024 %}
                                {{ "%.1f"|format(size/(1024*1024)) }} MB
                            {% elif size > 1024 %}
                                {{ "%.1f"|format(size/1024) }} KB
                            {% else %}
                                {{ size }} B
                            {% endif %}
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td>
                        <code class="text-truncate">{{ artifact.checksum[:8] if artifact.checksum else '—' }}</code>
                    </td>
                    <td>
                        <div class="btn-list flex-nowrap">
                            {{ caller(artifact) }}
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endmacro %}
